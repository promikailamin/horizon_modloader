//! Records the compiler and Horizon revision a runtime mod was built with.
//!
//! The runtime ABI hands trait objects between two separately compiled Rust
//! cdylibs. That is only sound when both sides use the same compiler and the
//! same Horizon source, so the macros in this crate embed both values and the
//! game refuses a mod whose header does not match.

use std::process::Command;

fn main() {
    println!("cargo:rerun-if-env-changed=HORIZON_REVISION");

    let rustc = std::env::var("RUSTC").unwrap_or_else(|_| "rustc".to_string());
    let rustc_version = Command::new(&rustc)
        .arg("--version")
        .output()
        .ok()
        .filter(|output| output.status.success())
        .and_then(|output| String::from_utf8(output.stdout).ok())
        .map(|text| text.trim().to_string())
        .filter(|text| !text.is_empty())
        .unwrap_or_else(|| "unknown".to_string());
    println!("cargo:rustc-env=HORIZON_RUNTIME_RUSTC={rustc_version}");

    let target = std::env::var("TARGET").unwrap_or_else(|_| "unknown".to_string());
    println!("cargo:rustc-env=HORIZON_RUNTIME_TARGET={target}");

    // A checkout knows its revision. A source export (git archive) does not, so
    // the mod builder sets HORIZON_REVISION to the commit it staged.
    let revision = std::env::var("HORIZON_REVISION")
        .ok()
        .filter(|revision| !revision.trim().is_empty())
        .or_else(git_revision)
        .unwrap_or_else(|| "unknown".to_string());
    println!("cargo:rustc-env=HORIZON_RUNTIME_REVISION={}", revision.trim());
    println!("cargo:rerun-if-changed=.git/HEAD");
}

fn git_revision() -> Option<String> {
    let root = std::path::PathBuf::from(std::env::var_os("CARGO_MANIFEST_DIR")?).join("../..");
    let output = Command::new("git")
        .arg("-C")
        .arg(root)
        .args(["rev-parse", "HEAD"])
        .output()
        .ok()?;
    output
        .status
        .success()
        .then(|| String::from_utf8_lossy(&output.stdout).trim().to_string())
        .filter(|revision| !revision.is_empty())
}
