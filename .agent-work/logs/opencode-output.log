65:          python3 tools/release_train.py decide --kind game ${HEAD_SHA:+--head "$HEAD_SHA"} ${FORCE:+--force} | tee decision.json
69:    # The Nightly is the release: nightly-build.yml builds the decided commit plus the reviewers' picks, signs it for
