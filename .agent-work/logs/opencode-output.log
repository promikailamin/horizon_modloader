            let hooks = descriptor.hooks;
            Ok(Self {
                info,
                path: path.to_path_buf(),
                library,
                hooks,
            })
        }

        /// Move the mod's `Box<dyn Hooks>` out and keep its library mapped for
        /// the process lifetime. The type parameter is the caller's promise
        /// that the descriptor holds a `Box<Box<T>>`; Horizon always passes
        /// `dyn horizon_client::mod_api::Hooks`.
        pub fn take_hooks<T: ?Sized>(self) -> Box<T> {
            let Self {
                library,
                hooks,
                info,
                path,
            } = self;
            // Unloading would invalidate the trait object's vtable and code.
            std::mem::forget(library);
            let _ = (info, path);
            let outer = hooks.cast::<Box<T>>();
            // SAFETY: the ABI stores a leaked Box<Box<T>> in `hooks`; moving the
            // inner Box out frees only the outer allocation.
            unsafe { *Box::from_raw(outer) }
        }
    }

    fn normalise_revision(revision: &str) -> &str {
        let revision = revision.trim();
        if revision.is_empty() || revision == "unknown" {
            ""
        } else {
            revision
        }
    }

    /// `HORIZON_REVISION` of this host build, for [`LoadedMod::load`].
    pub fn host_revision() -> &'static str {
        HORIZON_REVISION
    }

    /// The compiler string this host was built with.
    pub fn host_rustc() -> &'static str {
        RUSTC
    }

    /// The target triple this host was built for.
    pub fn host_target() -> &'static str {
        TARGET
    }
}
