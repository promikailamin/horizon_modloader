//! Startup shared by the gameplay library and its executable.
use crate::{crash, game, logging};

/// Start the game. The executable supplies the allocator and retains the mod API marker.
pub fn main() {
    main_with_owned(Vec::new());
}

/// Start the game with trait mods in dispatch order.
///
/// This older entry point takes an already-built `Mods`. Use
/// [`main_with_owned`] when the caller has a `Vec` and wants runtime-loaded
/// mods appended to it (the launcher's generated executable does).
pub fn main_with(mods: crate::mod_api::Mods) {
    start(mods);
}

/// Start the game with trait mods the caller owns, then append the mods found
/// by the runtime loader (`HORIZON_RUNTIME_MODS` or `horizon-runtime-mods/`).
pub fn main_with_owned(mods: Vec<Box<dyn crate::mod_api::Hooks>>) {
    main_with_named(mods, Vec::new());
}

/// Like [`main_with_owned`], naming the linked mods so a panic can say which
/// one broke. Runtime mods are named too, from their descriptors.
pub fn main_with_named(
    mut mods: Vec<Box<dyn crate::mod_api::Hooks>>,
    mut ids: Vec<&'static str>,
) {
    let runtime = crate::runtime_mods::load();
    mods.extend(runtime.mods);
    ids.extend(runtime.ids);
    if !ids.is_empty() {
        let names: &'static [&'static str] = Box::leak(ids.into_boxed_slice());
        crate::mod_api::name_mods(names);
    }
    start(mods.into());
}

fn start(mods: crate::mod_api::Mods) {
    // First: a trait injection into anything below (logging, the crash handler) calls its mod.
    if crate::mod_api::MODS.set(mods).is_err() {
        log::warn!("Trait mods already installed; ignoring the second list");
    }
    horizon_threads::configure_allocator();
    // The platform's features the dedicated server loads from server.toml, through the engine's hooks.
    horizon_chat_filter::install();
    crate::horizon_look::give();
    // OptiFine's and Polytone's pack formats (platform, docs/layers.md), before any pack loads.
    horizon_client::pack_formats::install();
