//! Runtime-loadable native mods for Horizon.
//!
//! Horizon's ordinary trait mods are linked into the game executable by the
//! launcher. This crate adds the other half: a mod may be compiled once as a
//! `cdylib` and loaded by an already-built game at startup, like a Fabric or
//! Forge jar, with no game compile on the player's machine.
//!
//! A mod exports one symbol, [`SYMBOL`], through [`export_runtime_mod!`]. The
//! symbol returns a [`DescriptorV1`] that points at the mod's leaked
//! `Box<Box<dyn Hooks>>`. The host ([`host`], feature `host`) opens the library,
//! checks the embedded build metadata, and takes the boxed trait object.
//!
//! ## Compatibility
//!
//! Rust has no stable trait-object ABI. A runtime mod is therefore accepted
//! only when its Horizon API level, Rust compiler string, target triple and
//! Horizon revision match the host's. That is deliberately strict: it keeps the
//! unsafe boundary to a build the author could have produced as a linked mod.
//!
//! The host keeps each library mapped for the process lifetime. A mod can use
//! every `Hooks` method of the Horizon it was built against.

use core::ffi::{c_char, c_void};

/// The symbol every runtime mod library exports.
pub const SYMBOL: &[u8] = b"horizon_runtime_mod_v1\0";

/// Version of this C header/layout. Bump on any field change.
pub const ABI_VERSION: u32 = 1;

/// The compiler that built this crate, embedded by `build.rs`.
pub const RUSTC: &str = env!("HORIZON_RUNTIME_RUSTC");
/// The target triple this crate was built for, embedded by `build.rs`.
pub const TARGET: &str = env!("HORIZON_RUNTIME_TARGET");
/// The Horizon revision this crate was built with, when it was known.
pub const HORIZON_REVISION: &str = env!("HORIZON_RUNTIME_REVISION");

/// The C layout a runtime mod returns from [`SYMBOL`].
///
/// Every string is a NUL-terminated UTF-8 string with static lifetime.
/// `hooks` is a leaked `Box<Box<dyn horizon_client::mod_api::Hooks>>`.
#[repr(C)]
pub struct DescriptorV1 {
    pub abi_version: u32,
    pub api_level: u32,
    pub target: *const c_char,
    pub rustc_version: *const c_char,
    pub horizon_revision: *const c_char,
    pub id: *const c_char,
    pub name: *const c_char,
    pub version: *const c_char,
    pub hooks: *mut c_void,
}

// The descriptor is immutable data shared across the FFI boundary.
unsafe impl Send for DescriptorV1 {}
unsafe impl Sync for DescriptorV1 {}

/// Export a `hooks()` function from a `cdylib` runtime mod.
///
/// ```ignore
/// use horizon_client::mod_api::{Hooks, PlayerLoggedInEvent};
///
/// pub fn hooks() -> Box<dyn Hooks> { Box::new(Mod) }
/// struct Mod;
/// impl Hooks for Mod {
///     fn player_logged_in(&self, _host: &mut dyn horizon_client::mod_api::Host, _event: &mut PlayerLoggedInEvent<'_>) {}
/// }
///
/// horizon_runtime_abi::export_runtime_mod! {
///     id = "example",
///     name = "Example",
///     version = "0.1.0",
///     hooks = hooks(),
/// }
/// ```
#[macro_export]
macro_rules! export_runtime_mod {
    (
        id = $id:literal,
        name = $name:literal,
        version = $version:literal,
        hooks = $hooks:expr $(,)?
    ) => {
        #[no_mangle]
        pub extern "C" fn horizon_runtime_mod_v1() -> *mut $crate::DescriptorV1 {
            static ID: &[u8] = ::core::concat!($id, "\0").as_bytes();
            static NAME: &[u8] = ::core::concat!($name, "\0").as_bytes();
            static VERSION: &[u8] = ::core::concat!($version, "\0").as_bytes();
            let hooks: ::std::boxed::Box<dyn horizon_client::mod_api::Hooks> =
                ::std::boxed::Box::new($hooks);
            let hooks: ::std::boxed::Box<
                ::std::boxed::Box<dyn horizon_client::mod_api::Hooks>,
            > = ::std::boxed::Box::new(hooks);
            let descriptor = ::std::boxed::Box::new($crate::DescriptorV1 {
                abi_version: $crate::ABI_VERSION,
                api_level: horizon_client::mod_api::RUNTIME_API_LEVEL,
                target: $crate::TARGET.as_ptr().cast(),
                rustc_version: $crate::RUSTC.as_ptr().cast(),
                horizon_revision: $crate::HORIZON_REVISION.as_ptr().cast(),
                id: ID.as_ptr().cast(),
                name: NAME.as_ptr().cast(),
                version: VERSION.as_ptr().cast(),
                hooks: ::std::boxed::Box::into_raw(hooks).cast(),
            });
            ::std::boxed::Box::into_raw(descriptor)
        }
    };
}

/// The game side of the runtime mod ABI (`feature = "host"`).
#[cfg(feature = "host")]
pub mod host {
    use super::{ABI_VERSION, DescriptorV1, HORIZON_REVISION, RUSTC, SYMBOL, TARGET};
    use core::ffi::{c_char, c_void};
    use libloading::Library;
    use std::ffi::CStr;
    use std::path::{Path, PathBuf};

    /// Metadata copied out of a mod's descriptor.
    #[derive(Clone, Debug, Eq, PartialEq)]
    pub struct Info {
        pub id: String,
        pub name: String,
        pub version: String,
        pub api_level: u32,
        pub target: String,
        pub rustc_version: String,
        pub horizon_revision: String,
    }

    /// A loaded runtime mod, still owned by its library.
    pub struct LoadedMod {
        pub info: Info,
        pub path: PathBuf,
        library: Library,
        hooks: *mut c_void,
    }

    // The library is process-wide data and the hooks trait is Send + Sync.
    unsafe impl Send for LoadedMod {}

    impl LoadedMod {
        /// Load and validate one mod. `api_level` is the host's
        /// `horizon_client::mod_api::RUNTIME_API_LEVEL`; `horizon_revision`
        /// is the host build's commit, or `"unknown"` when the build had none.
        pub fn load(
            path: &Path,
            api_level: u32,
            horizon_revision: &str,
        ) -> Result<Self, String> {
            // SAFETY: loading native code is inherently unsafe; the caller
            // chose the file and the checks below reject obvious mismatches.
            unsafe { Self::load_unchecked(path, api_level, horizon_revision) }
        }

        unsafe fn load_unchecked(
            path: &Path,
            api_level: u32,
            horizon_revision: &str,
        ) -> Result<Self, String> {
            // SAFETY: the caller passed this path to the runtime loader.
            let library = unsafe { Library::new(path) }
                .map_err(|error| format!("cannot open {}: {error}", path.display()))?;
            // SAFETY: the symbol is the documented entry point and its type is
            // fixed by ABI_VERSION; a library that lies is untrusted code.
            let entry: libloading::Symbol<unsafe extern "C" fn() -> *mut DescriptorV1> =
                unsafe { library.get(SYMBOL) }.map_err(|error| {
                    format!(
                        "{} is not a Horizon runtime mod (missing horizon_runtime_mod_v1): {error}",
                        path.display()
                    )
                })?;
            // SAFETY: called once, on the library's own thread, as the mod built it.
            let descriptor = unsafe { entry() };
            if descriptor.is_null() {
                return Err(format!("{} returned a null descriptor", path.display()));
            }
            // SAFETY: the pointer came from this library's entry point and is
            // read once, exactly as DescriptorV1 lays it out.
            let descriptor = unsafe { Box::from_raw(descriptor) };
            if descriptor.abi_version != ABI_VERSION {
                return Err(format!(
                    "{} uses runtime mod ABI {}, this Horizon has {ABI_VERSION}",
                    path.display(),
                    descriptor.abi_version
                ));
            }
            let text = |pointer: *const c_char, field: &str| -> Result<String, String> {
                if pointer.is_null() {
                    return Err(format!("{} has no {field}", path.display()));
                }
                // SAFETY: the ABI requires a NUL-terminated static string.
                unsafe { CStr::from_ptr(pointer) }
                    .to_str()
                    .map(str::to_owned)
                    .map_err(|_| format!("{} has a non-UTF-8 {field}", path.display()))
            };
            let info = Info {
                id: text(descriptor.id, "id")?,
                name: text(descriptor.name, "name")?,
                version: text(descriptor.version, "version")?,
                api_level: descriptor.api_level,
                target: text(descriptor.target, "target")?,
                rustc_version: text(descriptor.rustc_version, "rustc version")?,
                horizon_revision: text(descriptor.horizon_revision, "Horizon revision")?,
            };
            if info.api_level != api_level {
                return Err(format!(
                    "{} needs Horizon mod API {}, this Horizon has {api_level}",
                    path.display(),
                    info.api_level
                ));
            }
            if info.target != TARGET {
                return Err(format!(
                    "{} was built for {}, this computer is {TARGET}",
                    path.display(),
                    info.target
                ));
            }
            if info.rustc_version != RUSTC {
                return Err(format!(
                    "{} was built with {}, this Horizon was built with {RUSTC}; rebuild the mod with the same Rust",
                    path.display(),
                    info.rustc_version
                ));
            }
            let host_revision = normalise_revision(horizon_revision);
            let mod_revision = normalise_revision(&info.horizon_revision);
            if !host_revision.is_empty()
                && !mod_revision.is_empty()
                && host_revision != mod_revision
            {
                return Err(format!(
                    "{} was built against Horizon {}, this Horizon is {}; rebuild the mod against this commit",
                    path.display(),
                    info.horizon_revision,
                    horizon_revision
                ));
