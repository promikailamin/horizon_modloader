id: convert
        env:
          OUT_NAME: ${{ steps.inputs.outputs.out }}
          HORIZON_VERSION: ${{ steps.inputs.outputs.horizon_version }}
          PROFILE: ${{ inputs.profile }}
          ALLOW_MISMATCH: ${{ inputs.allow_mismatch }}
          MOD_COUNT: ${{ steps.inputs.outputs.mod_count }}
          MODS_SUMMARY: ${{ steps.inputs.outputs.mods_summary }}
          HORIZON_REVISION: ${{ steps.inputs.outputs.horizon_revision }}
          MIXINS_REVISION: ${{ steps.inputs.outputs.mixins_revision }}
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          mapfile -t mods < "${{ steps.inputs.outputs.mods_file }}"
          if [ "${#mods[@]}" -eq 0 ]; then
            echo "No .hnmod files resolved" >&2
            exit 1
          fi

          args=(
            convert "${mods[@]}"
            --out ".agent-work/outputs/$OUT_NAME"
            --source horizon-src
            --mixins horizon-mixins
            --profile "$PROFILE"
            --target-dir .agent-work/build/horizon-cargo
