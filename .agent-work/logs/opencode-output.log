//! Runtime-loaded trait mods (docs/runtime-mods.md).
//!
//! A runtime mod is the same `Hooks` implementation a linked trait mod has,
//! compiled once as a `cdylib` instead of being linked into the game. It is
//! discovered from `HORIZON_RUNTIME_MODS` (a platform path list) or a
//! `horizon-runtime-mods/` folder. The library stays mapped for the whole run.
//!
//! The loader is intentionally strict: the mod must name this Horizon's hook
//! API level, target, Ruff compiler build and git revision. Rust has no stable
//! trait-object ABI, so a mismatch is refused instead of risking undefined
//! behaviour.

use crate::mod_api::{Hooks, RUNTIME_API_LEVEL};
use horizon_runtime_abi::host::LoadedMod;
use std::path::{Path, PathBuf};

/// Mods found at startup, in load order, with the ids used for panic reports.
pub struct RuntimeMods {
    pub mods: Vec<Box<dyn Hooks>>,
    pub ids: Vec<&'static str>,
}

impl Default for RuntimeMods {
    fn default() -> Self {
        Self {
            mods: Vec::new(),
            ids: Vec::new(),
        }
    }
}

/// Load every runtime mod this game was asked to load.
pub fn load() -> RuntimeMods {
    let mut out = RuntimeMods::default();
    let mut seen = std::collections::BTreeSet::new();
    for path in candidates() {
        let path = match path.canonicalize() {
            Ok(path) => path,
            Err(error) => {
                eprintln!(
                    "Horizon: runtime mod path {} is not usable: {error}",
                    path.display()
                );
                continue;
            }
        };
        if !seen.insert(path.clone()) {
            continue;
        }
        match LoadedMod::load(&path, RUNTIME_API_LEVEL, horizon_runtime_abi::host::host_revision())
        {
            Ok(loaded) => {
                let info = loaded.info.clone();
                let id: &'static str = Box::leak(info.id.clone().into_boxed_str());
                let hooks = loaded.take_hooks::<dyn Hooks>();
                log::info!(
                    "Horizon: runtime mod {} {} ({}) loaded from {}",
                    info.name,
                    info.version,
                    info.id,
                    path.display()
                );
                eprintln!(
                    "Horizon: loaded runtime mod {} {} ({})",
                    info.name, info.version, info.id
                );
                out.mods.push(hooks);
                out.ids.push(id);
            }
            Err(error) => {
                eprintln!("Horizon: runtime mod not loaded: {error}");
                log::warn!("Horizon: runtime mod not loaded: {error}");
            }
        }
    }
    out
}

/// The files or folders to load, in order.
fn candidates() -> Vec<PathBuf> {
    let mut out = Vec::new();
    if let Some(value) = std::env::var_os("HORIZON_RUNTIME_MODS") {
        out.extend(std::env::split_paths(&value));
    } else if let Some(value) = std::env::var_os("HORIZON_RUNTIME_MOD_DIR") {
        out.push(PathBuf::from(value));
    } else {
        // The game's data folder, then the current folder and the executable's
        // folder, so both launchers and a checkout work without a setting.
        out.push(crate::logging::game_home().join("horizon-runtime-mods"));
        if let Ok(cwd) = std::env::current_dir() {
            out.push(cwd.join("horizon-runtime-mods"));
        }
        if let Ok(exe) = std::env::current_exe() {
            if let Some(dir) = exe.parent() {
                out.push(dir.join("horizon-runtime-mods"));
            }
        }
    }
    let mut files = Vec::new();
    for path in out {
        if path.is_dir() {
            if let Ok(entries) = std::fs::read_dir(&path) {
                let mut entries: Vec<_> = entries.filter_map(Result::ok).collect();
                entries.sort_by_key(|entry| entry.file_name());
                for entry in entries {
                    let path = entry.path();
                    if is_library(&path) {
                        files.push(path);
                    }
                }
            }
        } else if path.is_file() {
            files.push(path);
        }
    }
    files
}

fn is_library(path: &Path) -> bool {
    matches!(
        path.extension().and_then(|extension| extension.to_str()),
        Some("so" | "dylib" | "dll")
    )
}
