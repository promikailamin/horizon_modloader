name: Build .hmmod

on:
  workflow_dispatch:
    inputs:
      mods:
        description: >-
          .hnmod files to compile together, separated by spaces, commas or
          newlines. Use repository paths or public URLs.
        required: true
        default: tests/fixtures/example_mod-0.1.0.hnmod
        type: string
      out:
        description: Output .hmmod file name
        required: true
        default: example_mod-0.1.0.hmmod
        type: string
      profile:
        description: Cargo profile for the prebuilt Horizon client
        required: true
        default: fast
        type: choice
        options:
          - fast
          - release
      horizon_repo:
        description: Horizon git repository
        required: true
        default: https://github.com/horizon-rust/horizon
        type: string
      mixins_repo:
        description: horizon-mixins git repository
        required: true
        default: https://github.com/horizon-rust/horizon-mixins
        type: string
      mixins_revision:
        description: >-
          horizon-mixins commit. Leave blank to use the revision pinned by the
          first .hnmod.
        required: false
        default: ""
        type: string
      horizon_version:
        description: >-
          Human-readable base version for the manifest. Leave blank to use the
          game version from the first .hnmod.
        required: false
        default: ""
        type: string
      allow_mismatch:
        description: Allow bundles that pin different Horizon revisions
        required: false
        default: false
        type: boolean
      release_tag:
        description: >-
          Optional release tag. When set, the .hmmod and its SHA-256 are
          uploaded to that GitHub release (created if missing).
        required: false
        default: ""
        type: string

permissions:
  contents: write

concurrency:
  group: build-hmmod-${{ github.ref }}-${{ inputs.out }}
  cancel-in-progress: false

env:
  CARGO_TERM_COLOR: always

jobs:
  build:
    name: Compile mods into one .hmmod
    runs-on: ubuntu-latest
    timeout-minutes: 180
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Build hmloader
        run: cargo build --release --locked

      - name: Resolve .hnmod inputs
        id: inputs
        env:
          MODS_INPUT: ${{ inputs.mods }}
          OUT_NAME: ${{ inputs.out }}
          MIXINS_REVISION: ${{ inputs.mixins_revision }}
          HORIZON_VERSION: ${{ inputs.horizon_version }}
          ALLOW_MISMATCH: ${{ inputs.allow_mismatch }}
        run: |
          set -euo pipefail
          mkdir -p .agent-work/build .agent-work/logs .agent-work/outputs
          python3 scripts/resolve_build_inputs.py \
            --mods "$MODS_INPUT" \
            --out "$OUT_NAME" \
            --mixins-revision "$MIXINS_REVISION" \
            --horizon-version "$HORIZON_VERSION" \
            --allow-mismatch "$ALLOW_MISMATCH" \
            --inputs-dir .agent-work/tmp/build-inputs \
            --mods-file .agent-work/tmp/build-inputs/mods.txt

      - name: Restore Horizon Cargo cache
        uses: actions/cache@v4
        with:
          path: .agent-work/build/horizon-cargo
          key: horizon-cargo-${{ runner.os }}-${{ inputs.profile }}-${{ steps.inputs.outputs.horizon_revision }}-mixins-${{ steps.inputs.outputs.mixins_revision || 'default' }}
          restore-keys: |
            horizon-cargo-${{ runner.os }}-${{ inputs.profile }}-${{ steps.inputs.outputs.horizon_revision }}-

      - name: Check out Horizon
        env:
          HORIZON_REPO: ${{ inputs.horizon_repo }}
          HORIZON_REVISION: ${{ steps.inputs.outputs.horizon_revision }}
        run: |
          set -euo pipefail
          git init -q horizon-src
          git -C horizon-src remote add origin "$HORIZON_REPO"
          if ! git -C horizon-src fetch --depth 1 origin "$HORIZON_REVISION"; then
            echo "Shallow fetch failed; fetching the full history for $HORIZON_REVISION"
            git -C horizon-src fetch origin
          fi
          git -C horizon-src checkout -q --detach "$HORIZON_REVISION"

      - name: Check out horizon-mixins
        env:
          MIXINS_REPO: ${{ inputs.mixins_repo }}
          MIXINS_REVISION: ${{ steps.inputs.outputs.mixins_revision }}
        run: |
          set -euo pipefail
          if [ -z "$MIXINS_REVISION" ]; then
            echo "No horizon-mixins pin; using the default branch"
            git clone --depth 1 "$MIXINS_REPO" horizon-mixins
          else
            git init -q horizon-mixins
            git -C horizon-mixins remote add origin "$MIXINS_REPO"
            if ! git -C horizon-mixins fetch --depth 1 origin "$MIXINS_REVISION"; then
              echo "Shallow fetch failed; fetching the full history for $MIXINS_REVISION"
              git -C horizon-mixins fetch origin
            fi
            git -C horizon-mixins checkout -q --detach "$MIXINS_REVISION"
          fi

      - name: Compile and package
        id: convert
        env:
          OUT_NAME: ${{ steps.inputs.outputs.out }}
          HORIZON_VERSION: ${{ steps.inputs.outputs.horizon_version }}
          PROFILE: ${{ inputs.profile }}
          ALLOW_MISMATCH: ${{ inputs.allow_mismatch }}
          MOD_COUNT: ${{ steps.inputs.outputs.mod_count }}
          MODS_SUMMARY: ${{ steps.inputs.outputs.mods_summary }}
          HORIZON_REVISION: ${{ steps.inputs.outputs.horizon_revision }}
          MIXINS_REVISION: ${{ steps.inputs.outputs.mixins_revision }}
          RUN_ID: ${{ github.run_id }}
        run: |
          set -euo pipefail
          mapfile -t mods < "${{ steps.inputs.outputs.mods_file }}"
          if [ "${#mods[@]}" -eq 0 ]; then
            echo "No .hnmod files resolved" >&2
            exit 1
          fi

          args=(
            convert "${mods[@]}"
            --out ".agent-work/outputs/$OUT_NAME"
            --source horizon-src
            --mixins horizon-mixins
            --profile "$PROFILE"
            --target-dir .agent-work/build/horizon-cargo
            --work-dir .agent-work/build/work
          )
          if [ -n "$HORIZON_VERSION" ]; then
            args+=(--horizon-version "$HORIZON_VERSION")
          fi
          if [ "$ALLOW_MISMATCH" = "true" ]; then
            args+=(--allow-mismatch)
          fi

          started=$(date +%s)
          ./target/release/hmloader "${args[@]}" \
            2>&1 | tee ".agent-work/logs/build-$RUN_ID.log"
          elapsed=$(( $(date +%s) - started ))

          output=".agent-work/outputs/$OUT_NAME"
          size=$(stat -c%s "$output")
          hash=$(sha256sum "$output" | cut -d' ' -f1)
          printf '%s  %s\n' "$hash" "$OUT_NAME" > "$output.sha256"

          {
            echo "elapsed_seconds=$elapsed"
            echo "size_bytes=$size"
            echo "sha256=$hash"
          } >> "$GITHUB_OUTPUT"

          {
            echo "## .hmmod build"
            echo
            echo "| Item | Value |"
            echo "| --- | --- |"
            echo "| Mods | $MOD_COUNT: \`$MODS_SUMMARY\` |"
            echo "| Horizon | \`$HORIZON_REVISION\` |"
            echo "| horizon-mixins | \`${MIXINS_REVISION:-default branch}\` |"
            echo "| Profile | \`$PROFILE\` |"
            echo "| Build time | ${elapsed}s |"
            echo "| Size | ${size} bytes |"
            echo "| SHA-256 | \`$hash\` |"
            echo "| Artifact | \`$OUT_NAME\` |"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload .hmmod artifact
        uses: actions/upload-artifact@v4
        with:
          name: hmmod-${{ steps.inputs.outputs.out }}-${{ github.run_id }}
          path: |
            .agent-work/outputs/${{ steps.inputs.outputs.out }}
            .agent-work/outputs/${{ steps.inputs.outputs.out }}.sha256
            .agent-work/logs/build-${{ github.run_id }}.log
          if-no-files-found: error

      - name: Upload to GitHub release
        if: inputs.release_tag != ''
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ inputs.release_tag }}
          OUT_NAME: ${{ steps.inputs.outputs.out }}
          SHA256: ${{ steps.convert.outputs.sha256 }}
        run: |
          set -euo pipefail
          output=".agent-work/outputs/$OUT_NAME"
          if gh release view "$TAG" >/dev/null 2>&1; then
            gh release upload "$TAG" "$output" "$output.sha256" --clobber
          else
            gh release create "$TAG" "$output" "$output.sha256" \
              --target "$GITHUB_SHA" \
              --title "$TAG" \
              --notes "Precompiled .hmmod built by workflow run $GITHUB_RUN_ID. SHA-256: \`$SHA256\`."
          fi
---script---
#!/usr/bin/env python3
"""Resolve .hnmod inputs for the Build .hmmod workflow.

The workflow accepts repository paths and public URLs. This script copies or
downloads every bundle, reads the Horizon/mixins pins, rejects incompatible
combinations early, and writes the resolved values to ``$GITHUB_OUTPUT``.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import urllib.parse
import urllib.request
import uuid
import zipfile
from pathlib import Path

MAX_BUNDLE_BYTES = 128 * 1024 * 1024
MAX_MANIFEST_BYTES = 1024 * 1024
HEX = re.compile(r"^[0-9a-fA-F]{7,}$")


def fail(message: str) -> "None":
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def split_refs(value: str) -> list[str]:
    refs = [part for part in re.split(r"[\s,]+", value.strip()) if part]
    if not refs:
        fail("mods input is empty; give at least one .hnmod path or URL")
    return refs


def local_path(ref: str) -> Path:
    path = Path(ref).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    return path.resolve()


def url_filename(url: str) -> str:
    name = Path(urllib.parse.unquote(urllib.parse.urlparse(url).path)).name
    return name or "download.hnmod"


def download(url: str, dest: Path) -> None:
    print(f"downloading {url}")
    request = urllib.request.Request(
        url, headers={"User-Agent": "hmloader-build-workflow"}
    )
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            with dest.open("wb") as output:
                total = 0
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > MAX_BUNDLE_BYTES:
                        fail(f"{url} is larger than 128 MiB")
                    output.write(chunk)
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001 - report the URL and the real error
        fail(f"cannot download {url}: {exc}")
    if dest.stat().st_size == 0:
        fail(f"downloaded file is empty: {url}")


def read_manifest(path: Path) -> dict:
    try:
        with zipfile.ZipFile(path) as archive:
            try:
                info = archive.getinfo("horizon-native.json")
            except KeyError:
                fail(f"{path} has no horizon-native.json")
            if info.file_size > MAX_MANIFEST_BYTES:
                fail(f"{path}: horizon-native.json is unreasonably large")
            raw = archive.read("horizon-native.json")
    except zipfile.BadZipFile as exc:
        fail(f"{path} is not a .hnmod zip archive: {exc}")
    try:
        manifest = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"{path}: horizon-native.json is not valid JSON: {exc}")
    if not isinstance(manifest, dict):
        fail(f"{path}: horizon-native.json must be an object")
    return manifest


def require_text(manifest: dict, key: str, path: Path) -> str:
    value = manifest.get(key)
    if not isinstance(value, str) or not value.strip():
        fail(f"{path}: horizon-native.json has no {key}")
    return value.strip()


def optional_text(manifest: dict, key: str) -> str:
    value = manifest.get(key)
    return value.strip() if isinstance(value, str) else ""


def set_output(name: str, value: str) -> None:
    target = os.environ.get("GITHUB_OUTPUT")
    if not target:
        return
    with open(target, "a", encoding="utf-8") as output:
        if "\n" in value:
            delimiter = f"__hmloader_{uuid.uuid4().hex}__"
            output.write(f"{name}<<{delimiter}\n{value}\n{delimiter}\n")
        else:
            output.write(f"{name}={value}\n")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mods", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--mixins-revision", default="")
    parser.add_argument("--horizon-version", default="")
    parser.add_argument("--allow-mismatch", default="false")
    parser.add_argument("--inputs-dir", default=".agent-work/tmp/build-inputs")
    parser.add_argument(
        "--mods-file", default=".agent-work/tmp/build-inputs/mods.txt"
    )
    args = parser.parse_args()

    allow_mismatch = args.allow_mismatch.strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }

    out = args.out.strip()
    if not out.lower().endswith(".hmmod"):
        fail("out must end with .hmmod")
    if out in {".", ".."} or "/" in out or "\\" in out:
        fail("out must be a file name, not a path")

    refs = split_refs(args.mods)
    inputs_dir = Path(args.inputs_dir)
    if inputs_dir.exists():
        shutil.rmtree(inputs_dir)
    inputs_dir.mkdir(parents=True, exist_ok=True)

    mods: list[Path] = []
    used_names: set[str] = set()
    for index, ref in enumerate(refs, 1):
        if re.match(r"^https?://", ref, re.IGNORECASE):
            name = url_filename(ref)
            if not name.lower().endswith(".hnmod"):
                name += ".hnmod"
            dest = inputs_dir / name
            if name.lower() in used_names or dest.exists():
                dest = inputs_dir / f"{index:02d}-{name}"
            download(ref, dest)
        else:
            source = local_path(ref)
            if not source.is_file():
                fail(f"mod file not found: {ref} ({source})")
            dest = inputs_dir / source.name
            if source.name.lower() in used_names or dest.exists():
                dest = inputs_dir / f"{index:02d}-{source.name}"
            shutil.copyfile(source, dest)
        used_names.add(dest.name.lower())
        mods.append(dest.resolve())

    entries = []
    for path in mods:
        manifest = read_manifest(path)
        mod_id = require_text(manifest, "id", path)
        version = require_text(manifest, "version", path)
        horizon = require_text(manifest, "horizon", path)
        if not HEX.fullmatch(horizon):
            fail(f"{path}: horizon is not a hexadecimal commit id")
        mixins = optional_text(manifest, "mixins")
        if mixins and not HEX.fullmatch(mixins):
            fail(f"{path}: mixins is not a hexadecimal commit id")
        entries.append(
            {
                "path": path,
                "id": mod_id,
                "version": version,
                "horizon": horizon,
                "mixins": mixins,
                "game": optional_text(manifest, "game"),
            }
        )

    seen_ids: set[str] = set()
    for entry in entries:
        if entry["id"] in seen_ids:
            fail(f"two bundles have the same mod id: {entry['id']}")
        seen_ids.add(entry["id"])

    horizon = entries[0]["horizon"]
    mismatched = [e for e in entries[1:] if e["horizon"] != horizon]
    if mismatched and not allow_mismatch:
        details = ", ".join(f"{e['id']}={e['horizon']}" for e in mismatched)
        fail(
            "bundles pin different Horizon revisions "
            f"({entries[0]['id']}={horizon}, {details}); "
            "build them separately or set allow_mismatch"
        )

    mixins_revision = args.mixins_revision.strip()
    if mixins_revision and not HEX.fullmatch(mixins_revision):
        fail("mixins_revision is not a hexadecimal commit id")
    if not mixins_revision:
        pins = [e["mixins"] for e in entries if e["mixins"]]
        if pins:
            mixins_revision = pins[0]
            if len(set(pins)) > 1 and not allow_mismatch:
                fail(
                    "bundles pin different horizon-mixins revisions "
                    f"({', '.join(sorted(set(pins)))}); "
                    "set mixins_revision or allow_mismatch"
                )

    horizon_version = args.horizon_version.strip() or entries[0]["game"]

    mods_file = Path(args.mods_file)
    mods_file.parent.mkdir(parents=True, exist_ok=True)
    mods_file.write_text(
        "\n".join(str(path) for path in mods) + "\n", encoding="utf-8"
    )

    summary = "\n".join(
        f"- `{e['id']}` {e['version']} (`.hnmod`: `{e['path'].name}`)"
        for e in entries
    )
    print(f"resolved {len(entries)} mod(s):")
    print(summary)
    print(f"Horizon commit:  {horizon}")
    print(f"mixins commit:   {mixins_revision or '(default branch)'}")
    print(f"output:          {out}")

    set_output("mods_file", str(mods_file.resolve()))
    set_output("horizon_revision", horizon)
    set_output("mixins_revision", mixins_revision)
    set_output("horizon_version", horizon_version)
    set_output("out", out)
    set_output("mod_count", str(len(entries)))
    set_output(
        "mods_summary",
        ", ".join(f"{e['id']} {e['version']}" for e in entries),
    )


if __name__ == "__main__":
    main()
